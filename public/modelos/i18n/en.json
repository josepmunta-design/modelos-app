  ,"genogram.category.pareja.meaning": "Couple bond: marriage or stable union (solid line), cohabitation or commitment (dashed). One cross mark indicates separation; two indicate divorce."
  ,"genogram.category.parental": "Parent-child relationship"
  ,"genogram.category.parental.meaning": "Parent-to-child bond: biological (solid line), adoptive (dashed), or foster (dotted)."
  ,"genogram.category.alianza": "Alliance"
  ,"genogram.category.alianza.meaning": "Functional closeness or coalition between two members, often in relation to a third."
  ,"genogram.category.cercania": "Close relationship"
  ,"genogram.category.cercania.meaning": "A warm, connected bond in which each person keeps their own space. Drawn as a double line."
  ,"genogram.category.fusion": "Fusion / enmeshment"
  ,"genogram.category.fusion.meaning": "A bond with diffuse boundaries in which one person's wellbeing depends on the other. Drawn as a triple line."
  ,"genogram.category.distancia": "Emotional distance"
  ,"genogram.category.distancia.meaning": "Limited, disengaged, or indifferent contact. Dashed line."
  ,"genogram.category.corte": "Relationship cutoff"
  ,"genogram.category.corte.meaning": "A deliberate break in contact between two people. A cut line with two cross marks."
  ,"genogram.category.tension": "Tension"
  ,"genogram.category.tension.meaning": "Latent friction or unresolved disagreement short of open conflict. Soft broken line."
  ,"genogram.category.conflicto": "Conflict"
  ,"genogram.category.conflicto.meaning": "Active, recurrent disagreement. Zigzag line."
  ,"genogram.category.hostil": "Hostility / violence"
  ,"genogram.category.hostil.meaning": "Sustained antagonism or violence between members. A heavier, pronounced zigzag."
  ,"genogram.category.abuso": "Abuse"
  ,"genogram.category.abuso.meaning": "Physical, emotional, or sexual harm by one person toward another. A zigzag with an arrow pointing to the recipient."
  ,"genogram.category.anotacion": "Clinical annotation"
  ,"genogram.category.anotacion.meaning": "Clinical reading arrow: hypothesis, intervention focus, or observed relational function."
  ,"genogram.category.relacion": "Relationship"
  ,"genogram.category.relacion.meaning": "Unclassified bond."
